{
  "mcpServers": {
    "krita": {
      "title": "Krita Codex MCP",
      "description": "Control a local Krita session through the authenticated Krita Codex Bridge.",
      "command": "uvx",
      "args": [
        "--from",
        "krita-codex-mcp==0.2.2",
        "krita-codex-mcp"
      ],
      "env_vars": ["XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME"],
      "startup_timeout_sec": 60,
      "tool_timeout_sec": 210
    }
  }
}
